# --- Model ---
HF_MODEL=ggml-org/Qwen3.6-27B-MTP-GGUF:Q4_K_M
MODEL_ALIAS=qwen3.6-27b
HF_TOKEN=

# --- llama.cpp server ---
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
CTX_SIZE=32768
PARALLEL=1
KV_CACHE_TYPE=q8_0
BATCH_SIZE=4096
UBATCH_SIZE=1024

# --- Speculative decoding ---
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=3
SPEC_EXTRA_ARGS=

# --- Ollama-compatible endpoint ---
OLLAMA_PORT=11434
OLLAMA_COMPAT_VERSION=0.40.0

# --- Agents ---
AGENT_LLM_BACKEND=openai
AGENT_MAX_WORKERS=4
AGENT_MAX_REVISIONS=2
AGENT_ENABLE_THINKING=false

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090